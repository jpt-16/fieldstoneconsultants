# Resend (https://resend.com) - free tier is enough for a contact form
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Fieldstone Website <website@fieldstoneconsultants.com>"
CONTACT_FROM_EMAIL=
# Where submissions are delivered
CONTACT_TO_EMAIL=jon@fieldstoneconsultants.com
# Public site URL (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.fieldstoneconsultants.com
